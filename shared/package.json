{
  "name": "@typesync/shared",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/types.js",
  "types": "./types.ts",
  "exports": {
    "./editor-schema": {
      "types": "./editor-schema.ts",
      "import": "./dist/editor-schema.js"
    },
    ".": {
      "types": "./types.ts",
      "import": "./dist/types.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-code-block-lowlight": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-table-cell": "3.31.4",
    "@tiptap/extension-table-header": "3.31.4",
    "@tiptap/extension-table-row": "3.31.4",
    "@tiptap/extension-task-item": "3.31.4",
    "@tiptap/extension-task-list": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "lowlight": "^3.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
