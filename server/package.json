{
  "name": "@typesync/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/core": "1.7.6",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/y-tiptap": "^3.0.9",
    "@typesync/shared": "*",
    "better-auth": "^1.6.25",
    "cors": "^2.8.5",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "lib0": "^0.2.117",
    "pg": "^8.16.0",
    "proxy-addr": "2.0.8",
    "socket.io": "^4.8.0",
    "svix": "^2.8.0",
    "yjs": "^13.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/proxy-addr": "2.0.3",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3"
  }
}
