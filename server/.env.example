# Database
OPENROUTER_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free

DATABASE_URL=postgresql://typesync:typesync_dev@localhost:5432/typesync
# Production requires MIGRATION_DATABASE_URL with schema migration privileges.
# Locally, omit it to use DATABASE_URL, or set it to a separate migration login.
# MIGRATION_DATABASE_URL=postgresql://migration_login:password@localhost:5432/typesync

# Better Auth
BETTER_AUTH_SECRET=replace-this-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
AUTH_COOKIE_SAME_SITE=lax

# Email verification (required to create accounts or sign in with an unverified email)
# Use a sending_access Resend key scoped to your verified sending domain.
RESEND_API_KEY=
EMAIL_FROM=TypeSync <no-reply@mail.hetjethva.tech>

# Optional signed delivery diagnostics. Leave unset until a Resend endpoint is configured.
# RESEND_WEBHOOK_SECRET=whsec_<signing-key-from-resend>

# Server
PORT=3000
NODE_ENV=development

# Client URL (used by server for CORS and auth trusted origins)
VITE_CLIENT_URL=http://localhost:5173
