{
  "name": "typesync",
  "private": true,
  "version": "2.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w shared && npm run build -w client && npm run build -w server",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck -w shared -w client -w server",
    "typecheck:server": "npm run typecheck -w server",
    "typecheck:client": "npm run typecheck -w client",
    "db:push": "npm run db:push -w server",
    "db:studio": "npm run db:studio -w server",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.63.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "drizzle-kit": {
      "esbuild": "^0.28.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.1"
    }
  }
}
